    {name:'سرعت تشخیص رنگ ساده',display:Math.round(ma)+' ms',pct:clamp01((ma-300)/900),label:'اطلاعاتی',tone:'info',text:'سرعت پردازش پایه (به‌تنهایی تفسیر نمی‌شود).'}],flags};
