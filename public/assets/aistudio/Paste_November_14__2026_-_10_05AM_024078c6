   'پرهیز از اجرا بلافاصله پس از شیفت شب، دعوای کاری، یا خبر ناراحت‌کننده.',
   'فرد دارای عینک یا سمعک آن را همراه داشته باشد.',
   'دوباره‌خوانی گویه‌ها برای افراد کم‌سواد با خواندن بدون القای پاسخ توسط ارزیاب ممکن است؛ این موضوع را در گزارش ثبت کنید.',
   'برای مقایسه‌ی نتایج چند ماه بعد از همان شرایط تقریباً مشابه استفاده کنید.'])}</div></details>

  <details><summary>۷) پرسش‌های متداول</summary><div class="body">
   <p><b>آیا نمره‌ی پایین یعنی فرد مناسب نیست؟</b><br>خیر. نمره‌ها شاخص‌اند. تناسب فرد با شغل، آموزش و شرایط کار نیز مهم است.</p>
   <p><b>داده‌ها کجا ذخیره می‌شود؟</b><br>در حافظه‌ی همین مرورگر روی همین رایانه (localStorage) و به اینترنت ارسال نمی‌شود. اگر داده‌های مرورگر را پاک کنید یا از مرورگر دیگر باز کنید، اطلاعات دیده نمی‌شود؛ پس پشتیبان بگیرید.</p>
   <p><b>می‌توانم پرسشنامه‌ها را تغییر دهم؟</b><br>بله، متن و مرزها در بخش داده‌های فایل برنامه (آرایه‌ی QUESTIONNAIRES) قرار دارد و با ویرایشگر متن قابل ویرایش است.</p>
   <p><b>این آزمون‌ها با آزمون‌های معتبر معروف (مانند MMPI یا NEO) چه تفاوتی دارند؟</b><br>آن آزمون‌ها حق‌نشر و صلاحیت تفسیر تخصصی دارند. این برنامه از ابزارهای آزاد و گویه‌های اصل استفاده می‌کند و برای غربالگری و بحث در مصاحبه مناسب است، نه جایگزین آنها.</p>
  </div></details>`;
}

/* ====== تنظیمات ====== */
function download(name,text,type){const b=new Blob([text],{type});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),1500)}
function toCSV(){
  const rows=[['نام','کد','وضعیت','واحد','پست','آزمون','تاریخ','شاخص','نمره','سطح']];
  DB.people.forEach(p=>p.results.forEach(r=>r.dims.forEach(d=>rows.push([p.name,p.code,KIND[p.kind],p.dept,p.job,byId(r.testId).title,jdate(r.date),d.name,d.display,d.label]))));
  return'﻿'+rows.map(r=>r.map(c=>'"'+String(c??'').replace(/"/g,'""')+'"').join(',')).join('\r\n');
}
function vSettings(){
  view.innerHTML=`<h1>تنظیمات و پشتیبان</h1>
  <div class="card"><h2>اطلاعات گزارش</h2><div class="form"><div><label for="so">نام سازمان / کارخانه</label><input id="so" value="${esc(DB.org)}"></div><div><label for="se">نام ارزیاب / مسئول HSE</label><input id="se" value="${esc(DB.examiner)}"></div></div><p><button class="btn primary" id="ss">ذخیره</button></p></div>
  <div class="card"><h2>پشتیبان‌گیری و خروجی</h2><p class="small muted">داده‌ها فقط در همین مرورگر ذخیره می‌شود. حداقل ماهی یک‌بار پشتیبان بگیرید و فایل را در محل امن نگه دارید (فایل شامل اطلاعات حساس است).</p>
   <div class="row"><button class="btn primary" id="bk">دریافت پشتیبان (JSON)</button><button class="btn" id="cv">خروجی جدول (CSV برای Excel)</button><label class="btn" style="margin:0">بازیابی از پشتیبان<input type="file" id="rs" accept=".json,application/json" hidden></label></div></div>
  <div class="card"><h2>پاک‌سازی</h2><p class="small muted">حذف همه‌ی افراد و نتایج. قابل بازگشت نیست مگر پشتیبان داشته باشید.</p><button class="btn danger" id="wipe">حذف همه‌ی داده‌ها</button></div>`;
  $('#ss').onclick=()=>{DB.org=$('#so').value.trim();DB.examiner=$('#se').value.trim();saveDB();toast('ذخیره شد')};
  $('#bk').onclick=()=>{download('psychotest-backup-'+new Date().toISOString().slice(0,10)+'.json',JSON.stringify(DB),'application/json');toast('پشتیبان دریافت شد')};
  $('#cv').onclick=()=>{download('psychotest-results.csv',toCSV(),'text/csv;charset=utf-8');};
  $('#rs').onchange=e=>{const f=e.target.files[0];if(!f)return;const rd=new FileReader();rd.onload=()=>{try{const d=JSON.parse(rd.result);if(!d||!Array.isArray(d.people))throw 0;
      openSheet(`<h2>بازیابی پشتیبان</h2><p>${fa(d.people.length)} فرد در فایل است. داده‌های فعلی جایگزین شود یا با آنها ادغام شود؟</p><div class="row"><button class="btn primary" id="m1">جایگزین</button><button class="btn" id="m2">ادغام</button><button class="btn" id="m3">انصراف</button></div>`);
      $('#m1').onclick=()=>{DB={org:d.org||'',examiner:d.examiner||'',people:d.people};saveDB();closeSheet();toast('بازیابی شد');vSettings()};
      $('#m2').onclick=()=>{const have=new Set(DB.people.map(p=>p.id));d.people.forEach(p=>{if(!have.has(p.id))DB.people.push(p)});saveDB();closeSheet();toast('ادغام شد');vSettings()};
      $('#m3').onclick=closeSheet}catch(err){toast('فایل پشتیبان معتبر نیست')}};rd.readAsText(f)};
  $('#wipe').onclick=()=>{openSheet('<h2>حذف همه‌ی داده‌ها؟</h2><p>این کار برگشت‌پذیر نیست.</p><div class="row"><button class="btn danger" id="y">بله، حذف شود</button><button class="btn" id="n">انصراف</button></div>');
    $('#y').onclick=()=>{DB={org:DB.org,examiner:DB.examiner,people:[]};saveDB();closeSheet();toast('حذف شد');vSettings()};$('#n').onclick=closeSheet};
}
go('home');
</script></body></html>