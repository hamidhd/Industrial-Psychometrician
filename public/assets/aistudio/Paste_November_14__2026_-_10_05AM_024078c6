const clamp01=x=>Math.max(0,Math.min(1,x));

/* ---- ۱) زمان واکنش ---- */
function runReaction(el,finish){
  const TOTAL=6; let trial=-1,times=[],ant=0,timer=null,start=0,state='idle',dead=false;
  el.innerHTML='<div class="stage" id="st" tabindex="0" role="button" aria-label="ناحیه‌ی واکنش"><div><div class="big" id="sb">آماده‌اید؟</div><div class="small" id="ss">برای شروع کلیک کنید یا Space بزنید</div></div></div><p class="small muted" id="si" style="margin-top:8px">یک مرحله‌ی تمرینی و سپس ۵ مرحله‌ی ثبت‌شده انجام می‌شود.</p>';
  const st=el.querySelector('#st'),sb=el.querySelector('#sb'),ss=el.querySelector('#ss'),si=el.querySelector('#si');
  const set=(c,b,s)=>{st.className='stage '+c;sb.textContent=b;ss.textContent=s||''};
  const begin=()=>{state='wait';set('wait','صبر کنید…','وقتی صفحه سبز شد، فوراً بزنید');si.textContent=trial===0?'مرحله‌ی تمرینی':'مرحله '+trial+' از '+(TOTAL-1);
    timer=setTimeout(()=>{state='go';start=performance.now();set('go','حالا!','')},1500+Math.random()*2700)};
  const hit=()=>{
    if(dead)return;
    if(state==='idle'){trial=0;begin();return}
    if(state==='wait'){clearTimeout(timer);ant++;state='between';set('','زود بود!','برای تکرار همین مرحله بزنید');return}
    if(state==='go'){const rt=performance.now()-start;state='between';if(trial>0)times.push(rt);trial++;
      if(trial>=TOTAL){dead=true;cleanup();finish({times:times.map(Math.round),ant});return}
      set('',Math.round(rt)+' میلی‌ثانیه','برای مرحله‌ی بعد بزنید');return}
    if(state==='between')begin();
  };
  const kd=e=>{if(e.code==='Space'){e.preventDefault();hit()}};
  st.addEventListener('pointerdown',e=>{e.preventDefault();hit()});
  document.addEventListener('keydown',kd);
  function cleanup(){clearTimeout(timer);document.removeEventListener('keydown',kd)}
  return ()=>{dead=true;cleanup()};
}
function interpReaction(raw){
