/* نمره‌گذاری پرسشنامه‌ها */
function scoreQuestionnaire(q,answers){
  const {min,max}=q.scale,mult=q.mult||1;const raw={};
  q.items.forEach((it,i)=>{const d=it[1],r=it[2];let v=answers[i];if(r)v=min+max-v;raw[d]=(raw[d]||0)+v});
  const dims=[];const scMap={};
  Object.keys(q.dims).forEach(k=>{
    const n=q.items.filter(it=>it[1]===k).length,lo=n*min*mult,hi=n*max*mult,val=(raw[k]||0)*mult;
    const b=band(q.dims[k].bands,val);scMap[k]={value:val};
    dims.push({name:q.dims[k].name,display:val+' / '+hi,pct:hi>lo?(val-lo)/(hi-lo):0,label:b.label,tone:b.tone,text:b.text});
  });
  const flags=q.flags?q.flags(answers,scMap):[];
  return{dims,flags};
}
function tonePct(tone){return {good:'t-good',mid:'t-mid',warn:'t-warn',bad:'t-bad',info:''}[tone]||''}

