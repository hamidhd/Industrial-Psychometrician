  view.querySelectorAll('[data-b]').forEach(b=>b.onclick=()=>{const t=BATTERIES[b.dataset.b].tests;view.querySelectorAll('.tk').forEach(c=>c.checked=t.includes(c.value));upd();toast(BATTERIES[b.dataset.b].note)});
  $('#start').onclick=()=>{const ids=ALL.map(t=>t.id).filter(id=>view.querySelector('.tk[value="'+id+'"]').checked);
