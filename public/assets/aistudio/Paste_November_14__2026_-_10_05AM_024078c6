  const d2=band([{upTo:40,label:'پایدار',tone:'good',text:'واکنش‌ها یکنواخت است.'},{upTo:80,label:'متوسط',tone:'mid',text:'کمی نوسان.'},{upTo:99999,label:'ناپایدار',tone:'warn',text:'نوسان زیاد؛ نشانه‌ی افت توجه یا بی‌ثباتی هوشیاری.'}],s);
  const d3=raw.ant===0?{label:'بدون پیش‌دستی',tone:'good',text:'تکانشگری مشاهده نشد.'}:raw.ant<=2?{label:'گاهی',tone:'mid',text:'چند بار پیش از علامت واکنش داده است.'}:{label:'زیاد',tone:'warn',text:'پیش‌دستی مکرر؛ نشانه‌ی تکانشگری یا بی‌صبری.'};
  return{dims:[
    {name:'میانگین زمان واکنش',display:Math.round(m)+' ms',pct:clamp01((m-150)/450),...d1},
    {name:'نوسان واکنش (انحراف معیار)',display:Math.round(s)+' ms',pct:clamp01(s/150),...d2},
    {name:'واکنش زودهنگام (پیش‌دستی)',display:raw.ant+' بار',pct:clamp01(raw.ant/5),...d3}],flags:[]};
