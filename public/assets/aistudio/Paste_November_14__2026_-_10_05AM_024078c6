function runDigits(el,finish){
  let dead=false,submit=null,best={f:0,b:0};
  el.innerHTML='<div class="stage" id="st"><div style="width:100%"><div class="big" id="dg" style="direction:ltr"></div><div class="digits-in" id="din"></div><div class="small" id="dm"></div><div class="keypad" id="kp" hidden></div></div></div>';
  const dg=el.querySelector('#dg'),din=el.querySelector('#din'),dm=el.querySelector('#dm'),kp=el.querySelector('#kp');
  let cur='';
  const redraw=()=>{din.textContent=cur};
  '1234567890⌫✓'.split('').forEach(k=>{const b=document.createElement('button');b.textContent=k;b.onclick=()=>press(k);kp.appendChild(b)});
  const press=k=>{if(!submit)return;if(k==='⌫')cur=cur.slice(0,-1);else if(k==='✓'){const s=submit;submit=null;s(cur);return}else if(cur.length<12)cur+=k;redraw()};
  const kd=e=>{if(/^[0-9]$/.test(e.key))press(e.key);else if(e.key==='Backspace')press('⌫');else if(e.key==='Enter')press('✓')};
  document.addEventListener('keydown',kd);
  const msg=(t,b)=>new Promise(r=>{dg.textContent='';din.textContent='';kp.hidden=true;dm.innerHTML='<div style="max-width:520px;margin:auto;line-height:2">'+t+'</div><p><button class="btn primary" id="ok">'+(b||'ادامه')+'</button></p>';dm.querySelector('#ok').onclick=r});
  async function direction(dir){
    let len=dir==='f'?3:2;const max=dir==='f'?9:8;
    while(len<=max&&!dead){
      let passed=false;
      for(let t=0;t<2&&!passed&&!dead;t++){
        const seq=[];for(let i=0;i<len;i++){let d;do{d=Math.floor(Math.random()*10)}while(seq.length&&d===seq[seq.length-1]);seq.push(d)}
        dm.textContent='دقت کنید…';kp.hidden=true;din.textContent='';await sleep(700);
        for(const d of seq){if(dead)return;dg.textContent=d;await sleep(800);dg.textContent='';await sleep(250)}
        if(dead)return;
        cur='';redraw();dm.textContent=dir==='f'?'ارقام را به همان ترتیب وارد کنید و ✓ بزنید':'ارقام را به‌صورت «برعکس» وارد کنید و ✓ بزنید';kp.hidden=false;
        const ans=await new Promise(r=>submit=r);
        const target=(dir==='f'?seq:seq.slice().reverse()).join('');
        if(ans===target)passed=true;
      }
      if(passed){best[dir]=len;len++}else break;
    }
  }
  (async()=>{
    await msg('<b>بخش اول:</b> اعداد یکی‌یکی نمایش داده می‌شوند. آن‌ها را به همان ترتیب به خاطر بسپارید و سپس وارد کنید.');
    await direction('f');if(dead)return;
    await msg('<b>بخش دوم:</b> این بار اعداد را «برعکس» وارد کنید؛ مثلاً ۲-۵-۹ را به‌صورت ۹-۵-۲.');
    await direction('b');if(dead)return;
    cleanup();finish({f:best.f,b:best.b});
  })();
  function cleanup(){document.removeEventListener('keydown',kd)}
  return ()=>{dead=true;cleanup();submit=null};
}
