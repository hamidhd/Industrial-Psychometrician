/* ---- ۴) ردیابی اعداد و حروف (Trail A/B) ---- */
function runTrail(el,finish){
  const LET=['الف','ب','پ','ت','ث','ج','چ','ح','خ','د'];
  let dead=false;
  el.innerHTML='<div id="ti" class="small muted" style="margin-bottom:8px"></div><div class="trail" id="tr"></div><div id="tm"></div>';
  const tr=el.querySelector('#tr'),ti=el.querySelector('#ti'),tm=el.querySelector('#tm');
  const intro=(t)=>new Promise(r=>{tr.innerHTML='<div style="display:grid;place-items:center;height:100%;text-align:center;padding:16px"><div><p style="max-width:520px;line-height:2">'+t+'</p><button class="btn primary" id="go">شروع</button></div></div>';tr.querySelector('#go').onclick=r});
  function layout(seq){
    tr.innerHTML='';const cols=5,rows=Math.ceil(seq.length/cols);const cells=shuffle([...Array(cols*rows).keys()]).slice(0,seq.length);const nodes=[];
    seq.forEach((lab,i)=>{const c=cells[i]%cols,r=Math.floor(cells[i]/cols);const x=(c+0.5)/cols*100+(Math.random()-.5)*8,y=(r+0.5)/rows*100+(Math.random()-.5)*10;
      const b=document.createElement('button');b.className='node';b.textContent=lab;b.style.right=x+'%';b.style.top=y+'%';tr.appendChild(b);nodes.push(b)});
    return nodes;
  }
  const play=(seq)=>new Promise(res=>{
    const nodes=layout(seq);let idx=0,err=0;const t0=performance.now();
    ti.textContent='بعدی: '+seq[0];
    nodes.forEach((n,i)=>n.onclick=()=>{
      if(dead)return;
      if(i===idx){n.classList.add('done');idx++;if(idx>=seq.length){res({sec:(performance.now()-t0)/1000,err})}else ti.textContent='بعدی: '+seq[idx]}
      else{err++;n.classList.remove('err');void n.offsetWidth;n.classList.add('err')}
    });
  });
  (async()=>{
    await intro('<b>بخش اول:</b> اعداد ۱ تا ۲۰ را به ترتیب و تا جای ممکن سریع لمس یا کلیک کنید. اگر اشتباه کردید دوباره درست را بزنید؛ زمان ادامه دارد.');
    const A=[...Array(20).keys()].map(i=>String(i+1));const ra=await play(A);if(dead)return;
    await intro('<b>بخش دوم:</b> این بار به‌صورت یک‌درمیان عدد و حرف: ۱ ← الف ← ۲ ← ب ← ۳ ← پ … تا ۱۰ ← د. حروف به ترتیب: الف ب پ ت ث ج چ ح خ د.');
    const Bs=[];for(let i=0;i<10;i++){Bs.push(String(i+1));Bs.push(LET[i])}
    const rb=await play(Bs);if(dead)return;
    finish({a:+ra.sec.toFixed(1),b:+rb.sec.toFixed(1),errA:ra.err,errB:rb.err});
  })();
  return()=>{dead=true};
}
