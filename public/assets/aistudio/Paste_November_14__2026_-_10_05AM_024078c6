<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>روان‌سنج صنعتی</title>
<style>
/* Layout: top bar + tab navigation + single content column; cards on a pale steel ground */
:root{
  --bg:#edf0f2; --surface:#ffffff; --surface2:#f4f6f7; --ink:#1b2733; --muted:#5a6a78; --line:#d5dce1;
  --accent:#0e6a88; --accent-ink:#ffffff; --accent-soft:#dcedf3;
  --good:#23804f; --good-soft:#dff3e8; --mid:#8a6a00; --mid-soft:#fbf0cc;
  --warn:#b4560f; --warn-soft:#fde6d2; --bad:#b83232; --bad-soft:#fbdcdc;
  --font:'Vazirmatn','Tahoma','Segoe UI',system-ui,sans-serif;
  --radius:10px;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#12181e; --surface:#1b242c; --surface2:#222d36; --ink:#e6ecf0; --muted:#9aabb8; --line:#33414d;
  --accent:#4fb4d4; --accent-ink:#06222c; --accent-soft:#17323d;
  --good:#5cc78d; --good-soft:#173826; --mid:#e3c24d; --mid-soft:#3b3213;
  --warn:#f0954f; --warn-soft:#41290f; --bad:#f07a7a; --bad-soft:#431c1c; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#12181e; --surface:#1b242c; --surface2:#222d36; --ink:#e6ecf0; --muted:#9aabb8; --line:#33414d;
  --accent:#4fb4d4; --accent-ink:#06222c; --accent-soft:#17323d;
  --good:#5cc78d; --good-soft:#173826; --mid:#e3c24d; --mid-soft:#3b3213;
  --warn:#f0954f; --warn-soft:#41290f; --bad:#f07a7a; --bad-soft:#431c1c; color-scheme:dark}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font-family:var(--font);font-size:15px;line-height:1.8;
  padding-block:0;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.wrap{max-width:1080px;margin:0 auto}
header.top{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:16px 0 10px}
.logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:22px;letter-spacing:-.2px}
.logo i{display:inline-grid;place-items:center;width:38px;height:38px;border-radius:9px;background:var(--accent);color:var(--accent-ink);font-style:normal;font-size:18px;font-weight:800}
.logo small{display:block;font-weight:400;font-size:12px;color:var(--muted);line-height:1.2}
.spacer{flex:1}
nav.tabs{display:flex;gap:4px;flex-wrap:wrap;border-bottom:2px solid var(--line);margin-bottom:20px}
nav.tabs button{background:none;border:0;border-bottom:3px solid transparent;margin-bottom:-2px;padding:9px 14px;font:inherit;font-weight:500;color:var(--muted);cursor:pointer}
nav.tabs button:hover{color:var(--ink)}
nav.tabs button[aria-current="page"]{color:var(--accent);border-bottom-color:var(--accent);font-weight:700}
h1{font-size:24px;margin:0 0 4px;font-weight:800}
h2{font-size:18px;margin:0 0 10px;font-weight:700}
h3{font-size:15.5px;margin:0 0 6px;font-weight:700}
p{margin:0 0 10px}
.muted{color:var(--muted)}
.small{font-size:13px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:18px;margin-bottom:16px;min-width:0}
.grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.btn{font:inherit;font-weight:700;border:1px solid var(--line);background:var(--surface);color:var(--ink);padding:8px 16px;border-radius:8px;cursor:pointer}
.btn:hover{border-color:var(--accent)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn.danger{color:var(--bad);border-color:var(--bad)}
.btn.sm{padding:4px 11px;font-size:13px;font-weight:500}
.btn:disabled{opacity:.5;cursor:not-allowed}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
label{display:block;font-weight:500;font-size:13.5px;margin-bottom:3px}
input,select,textarea{font:inherit;width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink)}
.form{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
.badge{display:inline-block;padding:1px 10px;border-radius:99px;font-size:12.5px;font-weight:700;background:var(--surface2);border:1px solid var(--line)}
.b-good{background:var(--good-soft);color:var(--good);border-color:transparent}
.b-mid{background:var(--mid-soft);color:var(--mid);border-color:transparent}
.b-warn{background:var(--warn-soft);color:var(--warn);border-color:transparent}
.b-bad{background:var(--bad-soft);color:var(--bad);border-color:transparent}
.b-info{background:var(--accent-soft);color:var(--accent);border-color:transparent}
.tblwrap{overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:520px}
th,td{text-align:right;padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-size:13px;color:var(--muted);font-weight:500;background:var(--surface2)}
.stat{display:flex;flex-direction:column;gap:2px}
.stat b{font-size:28px;font-weight:800;line-height:1.2;font-variant-numeric:tabular-nums}
.notice{border-radius:var(--radius);padding:12px 14px;margin-bottom:14px;border:1px solid transparent}
.notice.info{background:var(--accent-soft);color:var(--ink);border-color:var(--accent)}
.notice.warn{background:var(--warn-soft);border-color:var(--warn)}
.notice.bad{background:var(--bad-soft);border-color:var(--bad)}
.notice b{display:block;margin-bottom:2px}
/* score meter */
.meter{position:relative;height:12px;border-radius:6px;background:var(--surface2);border:1px solid var(--line);overflow:hidden;margin:6px 0}
.meter>span{position:absolute;inset-block:0;right:0;border-radius:0 0 0 0;background:var(--accent)}
.meter.t-good>span{background:var(--good)}.meter.t-mid>span{background:var(--mid)}
.meter.t-warn>span{background:var(--warn)}.meter.t-bad>span{background:var(--bad)}
.dim{padding:12px 0;border-bottom:1px dashed var(--line)}
.dim:last-child{border-bottom:0}
.dim .head{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.dim .head strong{flex:1;min-width:120px}
.num{font-variant-numeric:tabular-nums;direction:ltr;unicode-bidi:isolate;display:inline-block}
/* questionnaire runner */
.qprog{height:6px;background:var(--surface2);border-radius:3px;overflow:hidden;margin-bottom:14px}
.qprog>span{display:block;height:100%;background:var(--accent);transition:width .2s}
.qitem{font-size:19px;font-weight:500;margin:6px 0 16px;min-height:3.6em;text-wrap:balance}
.opts{display:grid;gap:8px}
.opt{display:flex;gap:10px;align-items:center;text-align:right;width:100%;padding:11px 14px;border:1px solid var(--line);border-radius:9px;background:var(--surface);color:var(--ink);font:inherit;cursor:pointer}
.opt:hover{border-color:var(--accent);background:var(--accent-soft)}
.opt kbd{display:inline-grid;place-items:center;min-width:24px;height:24px;border-radius:6px;background:var(--surface2);border:1px solid var(--line);font:inherit;font-size:12px}
.opt.on{border-color:var(--accent);background:var(--accent-soft);font-weight:700}
/* task stage */
.stage{background:var(--surface2);border:1px solid var(--line);border-radius:var(--radius);min-height:300px;display:grid;place-items:center;text-align:center;padding:20px;user-select:none;touch-action:manipulation}
.stage.go{background:#1f9d57;color:#fff}.stage.wait{background:#b83232;color:#fff}
.stage .big{font-size:clamp(40px,10vw,84px);font-weight:800;line-height:1.2}
.colorbtns{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}
.cbtn{height:54px;border-radius:9px;border:3px solid var(--line);cursor:pointer;font:inherit;font-weight:700;color:#fff;text-shadow:0 1px 2px #0008}
.trail{position:relative;width:100%;height:420px;background:var(--surface2);border:1px solid var(--line);border-radius:var(--radius);touch-action:manipulation}
.node{position:absolute;width:46px;height:46px;margin:-23px -23px 0 0;border-radius:50%;border:2px solid var(--ink);background:var(--surface);color:var(--ink);font:inherit;font-weight:800;font-size:16px;cursor:pointer;display:grid;place-items:center;padding:0}
.node.done{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.node.err{animation:shake .25s}
@keyframes shake{25%{transform:translateX(5px)}75%{transform:translateX(-5px)}}
.keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;max-width:280px;margin:12px auto 0}
.keypad button{height:52px;font:inherit;font-size:20px;font-weight:700;border-radius:9px;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer}
.digits-in{direction:ltr;text-align:center;font-size:28px;letter-spacing:8px;min-height:44px;font-weight:800}
/* overlay */
.overlay{position:fixed;inset:0;background:#000a;display:none;z-index:50;padding:16px;overflow:auto}
.overlay.open{display:block}
.sheet{background:var(--surface);color:var(--ink);max-width:860px;margin:20px auto;border-radius:var(--radius);padding:22px;border:1px solid var(--line)}
.toast{position:fixed;bottom:calc(18px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:9px 18px;border-radius:99px;font-weight:700;display:none;z-index:99}
details{border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);margin-bottom:10px}
summary{cursor:pointer;padding:12px 16px;font-weight:700;list-style:none}
summary::-webkit-details-marker{display:none}
summary::before{content:"◂";display:inline-block;margin-left:8px;color:var(--accent);transition:transform .15s}
details[open]>summary::before{transform:rotate(-90deg)}
details>.body{padding:0 16px 14px}
.body ul{margin:4px 0 10px;padding-right:20px}
.body li{margin-bottom:3px}
.kv{display:grid;grid-template-columns:140px 1fr;gap:4px 12px;margin:6px 0 10px}
.kv dt{color:var(--muted);font-weight:500}.kv dd{margin:0}
@media (max-width:560px){.kv{grid-template-columns:1fr}.node{width:42px;height:42px;margin:-21px -21px 0 0}}
.only-print{display:none}
@media print{
  body{background:#fff;color:#000;padding:0;font-size:12.5px}
  header.top,nav.tabs,.no-print,.toast{display:none!important}
  .overlay{position:static;display:block!important;background:none;padding:0}
  .sheet{border:0;margin:0;max-width:none;padding:0;background:#fff;color:#000}
  .card,.dim{break-inside:avoid}
  body.printing>.wrap{display:none}
  .only-print{display:block}
}
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="logo"><i>ر</i><div>روان‌سنج صنعتی<small>آزمون‌های روان‌شناختی محیط کار</small></div></div>
    <div class="spacer"></div>
    <button class="btn sm" id="themeBtn" title="تغییر پوسته">☾ / ☀</button>
  </header>
  <nav class="tabs" id="tabs">
    <button data-v="home">داشبورد</button>
    <button data-v="people">پرسنل و داوطلبان</button>
    <button data-v="run">اجرای آزمون</button>
    <button data-v="results">نتایج و گزارش</button>
    <button data-v="help">راهنما و تفسیر</button>
    <button data-v="settings">تنظیمات و پشتیبان</button>
  </nav>
  <main id="view"></main>
</div>
<div class="overlay" id="ov"><div class="sheet" id="sheet"></div></div>
<div class="toast" id="toast"></div>
<script>
/* ====== تعریف پرسشنامه‌ها ====== */
const AGREE5=['کاملاً مخالفم','مخالفم','نظری ندارم','موافقم','کاملاً موافقم'];
const B=(upTo,label,tone,text)=>({upTo,label,tone,text});
const FINAL=999;

const QUESTIONNAIRES=[
{
 id:'ipip', title:'شخصیت پنج‌عاملی (فرم کوتاه ۲۰ گویه‌ای)', short:'شخصیت', minutes:5, scale:{min:1,max:5,labels:AGREE5},
 intro:'هر جمله را بخوانید و بر اساس اینکه «معمولاً» چقدر درباره‌ی شما صدق می‌کند پاسخ دهید. پاسخ درست یا غلط وجود ندارد؛ اولین حسِ خود را انتخاب کنید.',
 items:[
  ['در جمع‌ها شاد و پرانرژی‌ام و جمع را گرم می‌کنم.','E'],['با احساسات دیگران همدردی می‌کنم.','A'],
  ['کارهای روزمره را همان موقع انجام می‌دهم و عقب نمی‌اندازم.','C'],['حالات روحی‌ام زود‌به‌زود تغییر می‌کند.','N'],
  ['تخیل قوی و پرجزئیاتی دارم.','O'],['زیاد حرف نمی‌زنم.','E',1],['به مشکلات دیگران علاقه‌ای ندارم.','A',1],
  ['اغلب فراموش می‌کنم وسایل را سر جای خودشان بگذارم.','C',1],['بیشتر وقت‌ها آرام و آسوده‌ام.','N',1],
  ['درک مفاهیم انتزاعی برایم سخت است.','O',1],['در جمع‌ها با افراد زیادی صحبت می‌کنم.','E'],
  ['احساسات دیگران را حس می‌کنم.','A'],['نظم و ترتیب را دوست دارم.','C'],['زود ناراحت یا آشفته می‌شوم.','N'],
  ['به بحث‌های انتزاعی علاقه‌ای ندارم.','O',1],['ترجیح می‌دهم در پس‌زمینه بمانم و دیده نشوم.','E',1],
  ['واقعاً به دیگران علاقه‌ای ندارم.','A',1],['کارها را به هم می‌ریزم و شلوغ می‌کنم.','C',1],
  ['به‌ندرت احساس غمگینی می‌کنم.','N',1],['تخیل خوبی ندارم.','O',1]
 ],
 dims:{
  E:{name:'برون‌گرایی',bands:[
   B(9,'پایین','mid','کم‌حرف و مستقل؛ کار آرام و دقیق را ترجیح می‌دهد. در نقش‌های ارتباطی، آموزشی یا سرپرستی ممکن است به حمایت نیاز داشته باشد.'),
   B(14,'متوسط','good','تعادل میان کار گروهی و کار فردی.'),
   B(FINAL,'بالا','good','اجتماعی و پرانرژی؛ مناسب سرپرستی، آموزش و ارتباط با پیمانکاران. در کارهای یکنواخت و انفرادی طولانی ممکن است زود خسته شود.')]},
  A:{name:'توافق‌پذیری',bands:[
   B(9,'پایین','warn','صریح و رقابتی؛ در کار تیمی ممکن است تعارض ایجاد شود. در مصاحبه درباره‌ی همکاری و پذیرش تذکر بپرسید.'),
   B(14,'متوسط','good','همکار و در عین حال مستقل در تصمیم‌گیری.'),
   B(FINAL,'بالا','good','همدل و تیمی. ممکن است در تذکر دادن به همکار (مثلاً تذکر ایمنی) یا «نه» گفتن مشکل داشته باشد.')]},
  C:{name:'وظیفه‌شناسی',bands:[
   B(9,'پایین','bad','احتمال بی‌نظمی و بی‌دقتی. در مشاغل پرخطر (برق، مواد شیمیایی، کار در ارتفاع، ماشین‌آلات) بررسی تکمیلی لازم است.'),
   B(14,'متوسط','mid','نظم قابل قبول؛ با نظارت و آموزش مناسب عملکرد خوبی دارد.'),
   B(FINAL,'بالا','good','منظم، دقیق و پایبند به دستورالعمل. در مطالعات، قوی‌ترین پیش‌بین عملکرد شغلی و رفتار ایمن است. در حد افراطی ممکن است انعطاف کمی داشته باشد.')]},
  N:{name:'ناپایداری هیجانی (نوروتیسم)',bands:[
   B(9,'پایین','good','آرام و باثبات در فشار کاری.'),
   B(14,'متوسط','mid','واکنش هیجانی معمول.'),
   B(FINAL,'بالا','warn','واکنش‌پذیری هیجانی بالا. در شرایط پرفشار، اضطراری یا شیفت شب احتمال خطا بیشتر است. نتیجه را با پرسشنامه‌ی DASS و مصاحبه تکمیل کنید.')]},
  O:{name:'گشودگی به تجربه',bands:[
   B(9,'پایین','mid','عمل‌گرا و رویه‌محور؛ برای کارهای دستورالعملی مناسب است و تغییر را کندتر می‌پذیرد.'),
   B(14,'متوسط','good','تعادل میان رویه و نوآوری.'),
   B(FINAL,'بالا','good','خلاق و پذیرای تغییر؛ مناسب بهبود فرایند و ارائه‌ی پیشنهاد. ممکن است از کارهای کاملاً تکراری زود خسته شود.')]}
 },
 guide:{
  measures:'پنج بُعد پایدار شخصیت: برون‌گرایی، توافق‌پذیری، وظیفه‌شناسی، ناپایداری هیجانی و گشودگی. هر بُعد با ۴ گویه سنجیده می‌شود (نمره‌ی ۴ تا ۲۰). ساختار برگرفته از فرم کوتاه Mini-IPIP (حوزه‌ی عمومی)؛ متن فارسی ترجمه‌ی آزاد است.',
  admin:['محیط ساکت و بدون مزاحمت و بدون حضور همکاران یا سرپرست مستقیم.','بگویید پاسخ درست یا غلط وجود ندارد و صادق‌ترین پاسخ مفیدترین است.','گویه‌های معکوس به‌طور خودکار نمره‌گذاری می‌شوند؛ نیازی به محاسبه‌ی دستی نیست.'],
  use:['استخدام: به‌عنوان بخشی از مجموعه‌ی ارزیابی، نه تصمیم‌گیر نهایی.','پرسنل فعلی: ارتقا، تغییر نقش، تشکیل تیم و تعیین نیازهای آموزشی.'],
  limits:['خودگزارشی است و در استخدام ممکن است پاسخ‌ها مطلوب‌نما باشند؛ در کنار پرسشنامه‌ی درست‌کاری (دارای مقیاس روایی) استفاده شود.','نمرات ابعاد «تشخیص» نیستند و جایگاه بالا یا پایین به‌خودی‌خود خوب یا بد نیست؛ تناسب با نقش مهم است.']
 }
},
{
 id:'dass', title:'افسردگی، اضطراب و استرس (DASS-21)', short:'سلامت روان', minutes:5, mult:2,
 scale:{min:0,max:3,labels:['اصلاً در مورد من صدق نکرد','تا حدی یا گاهی صدق کرد','تا حد زیادی یا اغلب صدق کرد','کاملاً یا بیشتر وقت‌ها صدق کرد']},
 intro:'هر عبارت را بخوانید و مشخص کنید در طول «هفته‌ی گذشته» چقدر درباره‌ی شما صدق کرده است.',
 items:[
  ['به‌سختی می‌توانستم آرام شوم و تنش را کنار بگذارم.','S'],['دهانم خشک می‌شد.','A'],['به‌نظر نمی‌رسید اصلاً بتوانم احساس مثبتی داشته باشم.','D'],
  ['تنگی نفس داشتم (مثلاً نفس‌نفس زدن شدید بدون فعالیت بدنی).','A'],['شروع کردن به انجام کارها برایم دشوار بود.','D'],
  ['تمایل داشتم نسبت به اتفاقات واکنش بیش‌ازحد نشان دهم.','S'],['لرزش داشتم (مثلاً در دست‌ها).','A'],
