/* ---- ۲) استروپ رنگ-کلمه ---- */
const SCOL=[{n:'قرمز',c:'#d62828'},{n:'آبی',c:'#2a6df0'},{n:'سبز',c:'#1fa75a'},{n:'زرد',c:'#f0c419'}];
function runStroop(el,finish){
  let dead=false,keyH=null,pending=null;
  el.innerHTML='<div class="stage" id="st" style="background:#20262c;color:#fff"><div id="sc"></div></div><div class="colorbtns" id="cb"></div><p class="small muted" id="si" style="margin-top:8px"></p>';
  const sc=el.querySelector('#sc'),cb=el.querySelector('#cb'),si=el.querySelector('#si');
  SCOL.forEach((c,i)=>{const b=document.createElement('button');b.className='cbtn';b.style.background=c.c;b.style.borderColor=c.c;b.textContent=(i+1);b.setAttribute('aria-label',c.n);b.onclick=()=>ans(i);cb.appendChild(b)});
  const ans=i=>{if(pending){const p=pending;pending=null;p(i)}};
  keyH=e=>{const k=parseInt(e.key,10);if(k>=1&&k<=4)ans(k-1)};
  document.addEventListener('keydown',keyH);
  const waitStart=txt=>new Promise(r=>{sc.innerHTML='<div class="small" style="max-width:520px;line-height:2">'+txt+'</div><p><button class="btn primary" id="go">شروع</button></p>';sc.querySelector('#go').onclick=r});
  async function phase(trials){const out=[];for(const t of trials){if(dead)return out;sc.textContent='';await sleep(350);const w=document.createElement('div');w.className='big';w.style.color=SCOL[t.ink].c;w.textContent=t.word;sc.replaceChildren(w);const t0=performance.now();const r=await new Promise(res=>pending=res);if(dead)return out;out.push({rt:performance.now()-t0,ok:r===t.ink});sc.textContent=''}return out}
  (async()=>{
    await waitStart('<b>مرحله‌ی ۱:</b> به‌جای هر ■■■ رنگ آن را تشخیص دهید و دکمه‌ی همان رنگ (یا کلید ۱ تا ۴ صفحه‌کلید) را بزنید. هم سریع باشید هم درست.<br>۱=قرمز ۲=آبی ۳=سبز ۴=زرد');
    const A=[];let last=-1;for(let i=0;i<12;i++){let k;do{k=Math.floor(Math.random()*4)}while(k===last);last=k;A.push({word:'■■■■',ink:k})}
    const ra=await phase(A);if(dead)return;
    await waitStart('<b>مرحله‌ی ۲:</b> اکنون کلمات رنگ‌ها نوشته می‌شوند. <b>رنگِ حروف</b> را تشخیص دهید، نه معنای کلمه را. مثلاً کلمه‌ی «قرمز» با رنگ آبی → پاسخ آبی.');
    const Bt=[];last=-1;for(let i=0;i<20;i++){let k;do{k=Math.floor(Math.random()*4)}while(k===last);last=k;let w;do{w=Math.floor(Math.random()*4)}while(w===k);Bt.push({word:SCOL[w].n,ink:k})}
    const rb=await phase(Bt);if(dead)return;
    cleanup();finish({a:ra,b:rb});
  })();
  function cleanup(){document.removeEventListener('keydown',keyH)}
  return ()=>{dead=true;cleanup();if(pending){pending=null}};
}
function interpStroop(raw){
  const okA=raw.a.filter(x=>x.ok),okB=raw.b.filter(x=>x.ok);
  const ma=mean(okA.map(x=>x.rt)),mb=mean(okB.map(x=>x.rt)),inter=mb-ma;
