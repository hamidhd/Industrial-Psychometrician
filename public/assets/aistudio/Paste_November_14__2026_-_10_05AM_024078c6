function renderRun(){
  const r=state.run,t=byId(r.queue[r.i]),p=DB.people.find(x=>x.id===r.pid);
  view.innerHTML=`<div class="row" style="margin-bottom:10px"><span class="badge b-info">${esc(p.name)}</span><span class="badge">آزمون ${fa(r.i+1)} از ${fa(r.queue.length)}</span><div class="spacer"></div><button class="btn sm danger" id="abort">توقف و خروج</button></div>
  <div class="card"><h2>${esc(t.title)}</h2><div id="rbox"><p>${esc(t.intro)}</p><p class="small muted">زمان تقریبی: ${fa(t.minutes)} دقیقه</p><button class="btn primary" id="go">شروع</button></div></div>`;
  $('#abort').onclick=()=>{if(cleanupTask){cleanupTask();cleanupTask=null}state.run=null;go('run')};
  $('#go').onclick=()=>{
    const box=$('#rbox');
    if(t.type==='q')cleanupTask=runQ(box,t,ans=>finishTest(t,ans,{answers:ans,...scoreQuestionnaire(t,ans)}));
    else cleanupTask=t.run(box,raw=>finishTest(t,raw,{raw,...t.interpret(raw)}));
  };
}
function finishTest(t,payload,out){
  if(cleanupTask){cleanupTask();cleanupTask=null}
  const r=state.run,p=DB.people.find(x=>x.id===r.pid);
  p.results.unshift({id:uid(),testId:t.id,date:Date.now(),data:out.answers||out.raw,dims:out.dims,flags:out.flags||[]});
  saveDB();r.i++;
  if(r.i<r.queue.length){const box=$('#rbox');box.innerHTML='<p><b>ثبت شد.</b> آزمون بعدی: '+esc(byId(r.queue[r.i]).title)+'</p><button class="btn primary" id="nx">ادامه</button>';$('#nx').onclick=renderRun}
  else{state.run=null;state.sel=p.id;toast('همه‌ی آزمون‌ها ثبت شد');go('results')}
}
function runQ(box,q,done){
  const ans=[];let i=0;
  const kd=e=>{const k=parseInt(e.key,10),o=box.querySelectorAll('.opt');if(k>=1&&k<=o.length)o[k-1].click()};
  const stop=()=>document.removeEventListener('keydown',kd);
  const draw=()=>{
    if(i>=q.items.length){stop();done(ans);return}
    box.innerHTML=`<div class="qprog"><span style="width:${i/q.items.length*100}%"></span></div>
    ${i===0?'<p class="small muted">'+esc(q.intro)+'</p>':''}
    <div class="small muted">گویه ${fa(i+1)} از ${fa(q.items.length)}</div><div class="qitem">${esc(q.items[i][0])}</div>
    <div class="opts">${q.scale.labels.map((l,k)=>`<button class="opt ${ans[i]===q.scale.min+k?'on':''}" data-v="${q.scale.min+k}"><kbd>${fa(k+1)}</kbd>${esc(l)}</button>`).join('')}</div>
    <div class="row" style="margin-top:14px"><button class="btn sm" id="bk" ${i?'':'disabled'}>قبلی</button><span class="small muted">می‌توانید از کلیدهای ۱ تا ${fa(q.scale.labels.length)} صفحه‌کلید هم استفاده کنید.</span></div>`;
    box.querySelectorAll('.opt').forEach(b=>b.onclick=()=>{ans[i]=+b.dataset.v;i++;draw()});
    $('#bk',box).onclick=()=>{i--;draw()};
  };
  document.addEventListener('keydown',kd);draw();return stop;
}

